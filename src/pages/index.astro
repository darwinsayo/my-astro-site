---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(b.data.pubDate).valueOf());

const latestPost = posts[0];
const otherPosts = posts.slice(1, 4);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Proverbial Entropy</title>
    <meta name="description" content="Internal musings on modern chaos and the preservation of the soul." />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet" />

    <style>
      :root {
        --bg-color: #0b0b0c;
        --surface-color: #131316;
        --surface-hover: #18181c;
        --text-primary: #f2f0eb;
        --text-secondary: #949088;
        --accent-color: #dfbe93;
        --accent-glow: rgba(223, 190, 147, 0.08);
        --border-color: #232328;
      }

      * { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        background-color: var(--bg-color);
        color: var(--text-primary);
        padding: 0 1.5rem;
        font-family: 'Plus Jakarta Sans', sans-serif;
        font-weight: 300;
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
      }

      .container { max-width: 720px; margin: 0 auto; padding: 4rem 0 6rem; }

      .site-nav {
        text-transform: uppercase;
        letter-spacing: .12em;
        gap: 2rem;
        margin-bottom: 4rem;
        font-size: .75rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1.5rem;
      }
      .site-nav-links { display: flex; gap: 2rem; }
      .site-nav a { color: var(--text-secondary); text-decoration: none; transition: color .2s; }
      .site-nav a:hover { color: var(--accent-color); }
      .edition-badge { color: var(--accent-color); font-family: 'Cormorant Garamond', serif; font-size: 1rem; font-style: italic; }

      /* Dynamic Hero Header */
      header { 
        text-align: left; 
        border-bottom: 1px solid var(--border-color); 
        margin-bottom: 4rem; 
        padding-bottom: 3.5rem;
        position: relative;
      }
      header::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 80px;
        height: 2px;
        background-color: var(--accent-color);
      }
      .site-title { 
        letter-spacing: .03em; 
        color: var(--text-primary); 
        margin-bottom: .75rem; 
        font-family: 'Cormorant Garamond', serif; 
        font-size: 3.8rem; 
        font-weight: 600; 
        line-height: 1.1;
      }
      .site-tagline { 
        color: var(--text-secondary); 
        letter-spacing: .02em; 
        font-family: 'Cormorant Garamond', serif; 
        font-size: 1.25rem; 
        font-style: italic; 
      }

      /* Manifesto styling */
      .manifesto { color: #d6d3cc; margin-bottom: 5rem; font-size: 1.1rem; }
      .manifesto p { margin-bottom: 1.75rem; }
      .manifesto p:first-of-type::first-letter {
        float: left;
        color: var(--accent-color);
        padding-right: .75rem;
        font-family: 'Cormorant Garamond', serif;
        font-size: 4.2rem;
        line-height: .75;
      }

      .dispatches { margin-bottom: 5rem; }
      .section-header-flex { justify-content: space-between; align-items: baseline; margin-bottom: 2rem; display: flex; }
      .section-heading { color: var(--accent-color); text-transform: uppercase; letter-spacing: .1em; font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; font-weight: 400; }
      .view-all { color: var(--text-secondary); letter-spacing: .08em; text-transform: uppercase; font-size: .8rem; text-decoration: none; transition: color 0.2s; }
      .view-all:hover { color: var(--accent-color); }
      
      /* Featured Hero Dispatch Card */
      .dispatch-card.featured {
        background: linear-gradient(135deg, var(--surface-color) 0%, var(--surface-hover) 100%);
        border: 1px solid var(--accent-color);
        box-shadow: 0 10px 30px var(--accent-glow);
        padding: 2.75rem;
        margin-bottom: 2rem;
        position: relative;
      }
      .dispatch-card.featured::before {
        content: 'FEATURED DISPATCH';
        position: absolute;
        top: -12px;
        left: 2.5rem;
        background-color: var(--bg-color);
        color: var(--accent-color);
        padding: 0 0.75rem;
        font-size: 0.65rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .dispatch-card.featured .dispatch-title { font-size: 2.4rem; }

      /* Standard Dispatch Card */
      .dispatch-card {
        background-color: var(--surface-color);
        border: 1px solid var(--border-color);
        margin-bottom: 1.5rem;
        padding: 2.25rem;
        transition: all .3s cubic-bezier(0.16, 1, 0.3, 1);
      }
      .dispatch-card:hover { 
        border-color: var(--accent-color); 
        background-color: var(--surface-hover);
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.4);
      }
      
      .dispatch-date { color: var(--text-secondary); text-transform: uppercase; letter-spacing: .08em; margin-bottom: .75rem; font-size: .75rem; }
      .dispatch-title { margin-bottom: .75rem; font-family: 'Cormorant Garamond', serif; font-size: 1.8rem; font-weight: 600; line-height: 1.2; }
      .dispatch-title a { color: var(--text-primary); text-decoration: none; }
      .dispatch-excerpt { color: var(--text-secondary); margin-bottom: 0; font-size: 0.95rem; line-height: 1.7; }
      
      /* Newsletter Box */
      .subscribe-box { 
        background-color: var(--surface-color); 
        border: 1px solid var(--border-color); 
        text-align: center; 
        margin-top: 5rem; 
        padding: 3.5rem 2rem;
        position: relative;
      }
      .subscribe-box h3 { margin-bottom: .75rem; font-family: 'Cormorant Garamond', serif; font-size: 2.4rem; font-weight: 400; }
      .subscribe-box p { color: var(--text-secondary); margin-bottom: 2rem; font-size: 0.95rem; }
      .subscribe-form { gap: .5rem; max-width: 440px; margin: 0 auto; display: flex; }
      .subscribe-input { background-color: var(--bg-color); border: 1px solid var(--border-color); color: var(--text-primary); outline: none; flex: 1; padding: .9rem 1rem; font-family: inherit; font-size: .9rem; }
      .subscribe-input:focus { border-color: var(--accent-color); }
      .subscribe-btn { background-color: var(--accent-color); color: var(--bg-color); cursor: pointer; border: none; padding: .9rem 1.6rem; font-family: inherit; font-size: .9rem; font-weight: 500; transition: opacity .2s; }
      .subscribe-btn:hover { opacity: .9; }

      footer { text-align: center; border-top: 1px solid var(--border-color); color: var(--text-secondary); margin-top: 6rem; padding-top: 3rem; font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }

      @media (width <= 600px) { 
        .site-title { font-size: 2.8rem; } 
        .dispatch-card.featured .dispatch-title { font-size: 2rem; }
        .subscribe-form { flex-direction: column; }
      }
    </style>
  </head>
  <body>
    <div class="container">
      <!-- Global Navigation -->
      <nav class="site-nav">
        <span class="edition-badge">Vol. I</span>
        <div class="site-nav-links">
          <a href="/">Home</a>
          <a href="/dispatches">All Dispatches</a>
        </div>
      </nav>

      <header>
        <h1 class="site-title">Proverbial Entropy</h1>
        <p class="site-tagline">Internal musings on modern chaos and the preservation of the soul.</p>
      </header>

      <section class="manifesto">
        <p>Everything left to itself naturally drifts toward fragmentation. The culture hums with a quiet, persistent static—an endless rush of noise, distraction, and digital displacement that slowly pulls human attention apart at the seams.</p>
        <p>This space is an anonymous record of watching the world unravel, and wondering what happens to the interior life underneath the rubble. Not a call to panic, but an invitation to quiet persistence: building small, stubborn pockets of order where the soul can still breathe.</p>
      </section>

      <section class="dispatches">
        <div class="section-header-flex">
          <h2 class="section-heading">Recent Dispatches</h2>
          <a href="/dispatches" class="view-all">View all archive &rarr;</a>
        </div>

        {posts.length === 0 ? (
          <p style="color: var(--text-secondary);">No dispatches yet.</p>
        ) : (
          <>
            {/* Featured Hero Card for Latest Post */}
            {latestPost && (
              <article class="dispatch-card featured">
                <div class="dispatch-date">
                  <time datetime={new Date(latestPost.data.pubDate).toISOString()}>
                    {new Date(latestPost.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <h3 class="dispatch-title">
                  <a href={`/dispatches/${latestPost.id}`}>{latestPost.data.title}</a>
                </h3>
                {latestPost.data.description && (
                  <p class="dispatch-excerpt">{latestPost.data.description}</p>
                )}
              </article>
            )}

            {/* Remaining Posts */}
            {otherPosts.map((post) => (
              <article class="dispatch-card">
                <div class="dispatch-date">
                  <time datetime={new Date(post.data.pubDate).toISOString()}>
                    {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                </div>
                <h3 class="dispatch-title">
                  <a href={`/dispatches/${post.id}`}>{post.data.title}</a>
                </h3>
                {post.data.description && (
                  <p class="dispatch-excerpt">{post.data.description}</p>
                )}
              </article>
            ))}
          </>
        )}
      </section>

      <section class="subscribe-box">
        <h3>Receive New Dispatches</h3>
        <p>Get new writing delivered quietly to your inbox. No noise, just reflections.</p>
        <form class="subscribe-form" onsubmit="event.preventDefault(); alert('Subscribed successfully.');">
          <input type="email" class="subscribe-input" placeholder="Your email address" required />
          <button type="submit" class="subscribe-btn">Subscribe</button>
        </form>
      </section>

      <!-- Global Footer -->
      <footer>
        <p>&copy; 2026 Proverbial Entropy. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html>