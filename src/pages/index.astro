---
import BaseLayout from '../layouts/BaseLayout.astro';
import DispatchCard from '../components/DispatchCard.astro';
import Entropy from '../components/Entropy.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const [latest, ...rest] = posts;
const recent = rest.slice(0, 3);
---

<BaseLayout>
	<header class="hero">
		<h1 class="page-title">Proverbial Entropy</h1>
		<p class="page-tagline">Internal musings on modern chaos and the preservation of the soul.</p>
		<Entropy class="hero-ornament" width={340} count={38} seed={11} animate />
	</header>

	<section class="manifesto" aria-label="About this site">
		<p>
			Everything left to itself naturally drifts toward fragmentation. The culture hums with a quiet,
			persistent static—an endless rush of noise, distraction, and digital displacement that slowly
			pulls human attention apart at the seams.
		</p>
		<p>
			This space is an anonymous record of watching the world unravel, and wondering what happens to
			the interior life underneath the rubble. Not a call to panic, but an invitation to quiet
			persistence: <em>building small, stubborn pockets of order where the soul can still breathe.</em>
		</p>
	</section>

	<section class="dispatches" aria-labelledby="recent-heading">
		<div class="section-head">
			<h2 class="section-heading" id="recent-heading">Recent Dispatches</h2>
			{posts.length > 1 && <a href="/dispatches" class="text-link">Full archive &rarr;</a>}
		</div>

		{posts.length === 0 && <p class="empty">The first dispatch is still being written.</p>}
		{latest && <DispatchCard post={latest} featured />}
		{recent.map((post) => <DispatchCard post={post} />)}
	</section>

	<aside class="follow">
		<h2>Follow the dispatches</h2>
		<p>
			New writing arrives slowly and on no schedule. Add the feed to any RSS reader and it will find you
			when it does.
		</p>
		<a class="button" href="/rss.xml">Subscribe via RSS</a>
	</aside>
</BaseLayout>

<style>
	.hero {
		position: relative;
		padding-bottom: 3rem;
		margin-bottom: 3.5rem;
	}
	.hero :global(.hero-ornament) {
		margin-top: 2.25rem;
	}

	@media (prefers-reduced-motion: no-preference) {
		.hero .page-title,
		.hero .page-tagline {
			animation: rise 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
		}
		.hero .page-tagline {
			animation-delay: 0.25s;
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(12px);
			filter: blur(4px);
		}
	}

	.manifesto {
		color: var(--text-body);
		font-size: 1.1rem;
		font-weight: 300;
		margin-bottom: 5rem;
	}
	.manifesto p + p {
		margin-top: 1.6rem;
	}
	.manifesto p:first-of-type::first-letter {
		float: left;
		font-family: var(--serif);
		font-size: 4.6rem;
		line-height: 0.8;
		padding: 0.35rem 0.7rem 0 0;
		color: var(--accent);
	}
	.manifesto em {
		font-family: var(--serif);
		font-size: 1.15em;
		line-height: 1;
		font-style: italic;
		color: var(--text);
	}

	.section-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.empty {
		color: var(--text-muted);
		font-style: italic;
	}

	.follow {
		margin-top: 5rem;
		padding: 3rem 2rem;
		text-align: center;
		border-top: 1px solid var(--border);
	}
	.follow h2 {
		font-family: var(--serif);
		font-weight: 400;
		font-size: 2.1rem;
		line-height: 1.2;
		margin-bottom: 0.75rem;
	}
	.follow p {
		color: var(--text-muted);
		font-size: 0.95rem;
		max-width: 30rem;
		margin: 0 auto 1.75rem;
	}
	.button {
		display: inline-block;
		padding: 0.85rem 1.6rem;
		border: 1px solid var(--accent);
		color: var(--accent);
		text-decoration: none;
		font-size: 0.72rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.16em;
		transition: background-color 0.2s, color 0.2s;
	}
	.button:hover {
		background: var(--accent);
		color: var(--bg);
	}

	@media (max-width: 560px) {
		.manifesto {
			font-size: 1.02rem;
		}
		.follow {
			padding: 2.5rem 0.5rem;
		}
	}
</style>
