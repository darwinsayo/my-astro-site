---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DispatchCard from '../../components/DispatchCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();

// Group by year, newest first
const years = new Map<number, typeof posts>();
for (const post of posts) {
	const y = post.data.pubDate.getUTCFullYear();
	years.set(y, [...(years.get(y) ?? []), post]);
}
---

<BaseLayout title="All Dispatches" description="An archive of thoughts on societal decay and the soul.">
	<header class="archive-header">
		<p class="kicker">The archive · {posts.length} {posts.length === 1 ? 'dispatch' : 'dispatches'}</p>
		<h1 class="page-title">All Dispatches</h1>
		<p class="page-tagline">An archive of thoughts on societal decay and the soul.</p>
	</header>

	{posts.length === 0 && <p class="empty">Nothing here yet. Check back soon.</p>}

	{
		[...years].map(([year, list]) => (
			<section class="year" aria-labelledby={`y${year}`}>
				<h2 class="year-label" id={`y${year}`}>{year}</h2>
				{list.map((post) => <DispatchCard post={post} headingLevel="h3" />)}
			</section>
		))
	}
</BaseLayout>

<style>
	.archive-header {
		margin-bottom: 3.5rem;
		padding-bottom: 3rem;
		border-bottom: 1px solid var(--border);
	}
	.archive-header .page-title {
		margin-top: 0.75rem;
	}
	.year + .year {
		margin-top: 3.5rem;
	}
	.year-label {
		display: flex;
		align-items: center;
		gap: 1rem;
		font-family: var(--serif);
		font-style: italic;
		font-weight: 400;
		font-size: 1.4rem;
		color: var(--accent);
		margin-bottom: 1.5rem;
	}
	.year-label::after {
		content: '';
		flex: 1;
		height: 1px;
		background: var(--border);
	}
	.empty {
		color: var(--text-muted);
		font-style: italic;
	}
</style>
