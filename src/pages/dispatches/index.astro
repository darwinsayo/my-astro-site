---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const posts = allPosts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<BaseLayout title="All Dispatches | Proverbial Entropy">
    <header class="archive-header">
        <h1 class="site-title">All Dispatches</h1>
        <p class="site-tagline">An archive of thoughts on societal decay and the soul.</p>
    </header>

    <section class="dispatches-list">
        {posts.map((post) => (
            <article class="dispatch-card">
                <div class="dispatch-date">
                    {new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </div>
                <h2 class="dispatch-title">
                    <a href={`/dispatches/${post.id}`}>{post.data.title}</a>
                </h2>
                <p class="dispatch-excerpt">{post.data.description}</p>
            </article>
        ))}
    </section>
</BaseLayout>

<style>
    .archive-header {
        text-align: center;
        margin-bottom: 4rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 3rem;
    }
    .dispatch-card {
        background-color: var(--surface-color);
        border: 1px solid var(--border-color);
        padding: 2rem;
        margin-bottom: 1.5rem;
        transition: border-color 0.3s ease;
    }
    .dispatch-card:hover {
        border-color: var(--accent-color);
    }
    .dispatch-date {
        font-size: 0.85rem;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
    }
    .dispatch-title {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.8rem;
        margin-bottom: 0.75rem;
        font-weight: 600;
    }
    .dispatch-title a {
        color: var(--text-primary);
        text-decoration: none;
    }
    .dispatch-excerpt {
        color: var(--text-secondary);
        font-size: 0.95rem;
        margin-bottom: 0;
    }
</style>