---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<!-- Your existing HTML markup starts right here -->
<div class="post-meta">
    <a href="/dispatches" class="back-link">&larr; Back to all dispatches</a>
    <div class="post-meta-right">
        {post.data.category && (
            <span class="post-category">
                {post.data.category.replace('-', ' ')} &bull; 
            </span>
        )}
        {post.data.author && (
            <span class="post-author">
                {post.data.author} &bull; 
            </span>
        )}
        <span class="post-date">
            {new Date(post.data.pubDate || post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
    </div>
</div>

<article>
    <h1>{post.data.title}</h1>
    <Content />
</article>