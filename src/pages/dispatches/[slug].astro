---
import { getCollection, render } from 'astro:content'; // <-- Import render here

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post); // <-- Use render(post) instead of post.render()
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.data.title} — Proverbial Entropy</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
    
    <style>
      :root {
        --bg-color: #121212;
        --surface-color: #1a1a1a;
        --text-primary: #e6e4df;
        --text-secondary: #9e9b96;
        --accent-color: #c5a880;
        --border-color: #2a2a2a;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        background-color: var(--bg-color);
        color: var(--text-primary);
        padding: 0 1.5rem;
        font-family: Plus Jakarta Sans, sans-serif;
        font-weight: 300;
        line-height: 1.7;
      }
      .container { max-width: 720px; margin: 0 auto; padding: 3rem 0 5rem; }
      .site-nav {
        text-transform: uppercase;
        letter-spacing: .05em;
        gap: 1.5rem;
        margin-bottom: 3rem;
        font-size: .9rem;
        display: flex;
      }
      .site-nav a { color: var(--text-secondary); text-decoration: none; transition: color .2s; }
      .site-nav a:hover { color: var(--accent-color); }
      article { margin-top: 2rem; }
      article h1 {
        font-family: Cormorant Garamond, serif;
        font-size: 2.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        color: var(--text-primary);
      }
      .dispatch-date {
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 2rem;
        font-size: .85rem;
      }
      .prose { color: var(--text-primary); font-size: 1.05rem; }
      .prose p { margin-bottom: 1.5rem; }
      footer { text-align: center; border-top: 1px solid var(--border-color); color: var(--text-secondary); margin-top: 4rem; padding-top: 3rem; font-size: .85rem; }
    </style>
  </head>
  <body>
    <div class="container">
      <nav class="site-nav">
        <a href="/">&larr; Home</a>
        <a href="/dispatches">All Dispatches</a>
      </nav>

      <main>
        <article>
          <h1>{post.data.title}</h1>
          <div class="dispatch-date">
            <time datetime={new Date(post.data.pubDate).toISOString()}>
              {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
          </div>
          <div class="prose">
            <Content />
          </div>
        </article>
      </main>

      <footer>
        <p>&copy; 2026 Proverbial Entropy. All rights reserved.</p>
      </footer>
    </div>
  </body>
</html> 