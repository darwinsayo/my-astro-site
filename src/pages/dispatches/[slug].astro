---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Entropy from '../../components/Entropy.astro';
import { excerpt, formatDate, getPosts, readingTime, splitList, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1], older: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	newer?: Post;
	older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, pubDate, author, categories, tags, image, description } = post.data;

const category = splitList(categories)[0];
const tagList = splitList(tags);
const desc = (description ?? '').trim();
const deck = desc.length >= 60 && !title.toLowerCase().includes(desc.toLowerCase()) ? desc : undefined;
---

<BaseLayout title={title} description={excerpt(post, 30)} image={image} type="article">
	<article class="dispatch">
		<header class="dispatch-header">
			<p class="kicker">
				<a href="/dispatches" class="crumb">Dispatches</a>
				{category && <> <span aria-hidden="true">/</span> <span class="accent">{category}</span></>}
			</p>
			<h1 class="page-title">{title}</h1>
			{deck && <p class="page-tagline">{deck}</p>}

			<div class="byline">
				{author && <span class="author">By {author}</span>}
				<time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
				<span>{readingTime(post)}</span>
			</div>
		</header>

		{image && <img class="dispatch-image" src={image} alt="" />}

		<div class="prose">
			<Content />
		</div>

		<Entropy class="end-mark" width={200} count={24} seed={pubDate.getUTCDate()} />

		{
			tagList.length > 0 && (
				<ul class="tags" aria-label="Tags">
					{tagList.map((t) => (
						<li>{t}</li>
					))}
				</ul>
			)
		}
	</article>

	<nav class="pager" aria-label="More dispatches">
		{
			older ? (
				<a href={`/dispatches/${older.id}`} class="pager-link">
					<span class="kicker">&larr; Older</span>
					<span class="pager-title">{older.data.title}</span>
				</a>
			) : (
				<span />
			)
		}
		{
			newer ? (
				<a href={`/dispatches/${newer.id}`} class="pager-link pager-link--next">
					<span class="kicker">Newer &rarr;</span>
					<span class="pager-title">{newer.data.title}</span>
				</a>
			) : (
				<a href="/dispatches" class="pager-link pager-link--next">
					<span class="kicker">The archive &rarr;</span>
					<span class="pager-title">All dispatches</span>
				</a>
			)
		}
	</nav>
</BaseLayout>

<style>
	.dispatch-header {
		margin-bottom: 3rem;
	}
	.crumb {
		text-decoration: none;
		transition: color 0.2s;
	}
	.crumb:hover {
		color: var(--accent);
	}
	.dispatch-header .page-title {
		margin-top: 1rem;
		font-size: clamp(2.3rem, 7vw, 3.4rem);
	}
	.byline {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1.25rem;
		margin-top: 1.75rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--border);
		font-size: 0.72rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
	}
	.author {
		color: var(--accent);
	}

	.dispatch-image {
		width: 100%;
		max-height: 520px;
		object-fit: cover;
		margin-bottom: 3rem;
		border: 1px solid var(--border);
	}

	.dispatch :global(.end-mark) {
		margin: 3.5rem 0 2rem;
	}

	.tags {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.tags li {
		font-size: 0.68rem;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--text-muted);
		border: 1px solid var(--border);
		padding: 0.3rem 0.75rem;
	}

	/* ---------- Older / newer ---------- */
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1rem;
		margin-top: 4.5rem;
	}
	.pager-link {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding: 1.4rem 1.5rem;
		border: 1px solid var(--border);
		background: var(--surface);
		text-decoration: none;
		transition: border-color 0.3s;
	}
	.pager-link:hover {
		border-color: var(--accent);
	}
	.pager-link--next {
		text-align: right;
		grid-column: 2;
	}
	.pager-title {
		font-family: var(--serif);
		font-size: 1.25rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--text);
	}

	@media (max-width: 560px) {
		.prose {
			font-size: 1.04rem;
		}
		.pager {
			grid-template-columns: 1fr;
		}
		.pager-link--next {
			grid-column: 1;
		}
	}
</style>

<style is:global>
	/* ---------- The reading column ---------- */
	.prose {
		font-size: 1.08rem;
		font-weight: 400;
		line-height: 1.85;
		color: var(--text-body);
		hyphens: auto;
	}
	.prose > * + * {
		margin-top: 1.5em;
	}
	.prose > p:first-of-type::first-letter {
		float: left;
		font-family: var(--serif);
		font-size: 4.4em;
		line-height: 0.8;
		padding: 0.08em 0.12em 0 0;
		color: var(--accent);
	}
	.prose h2,
	.prose h3 {
		font-family: var(--serif);
		font-weight: 600;
		color: var(--text);
		line-height: 1.25;
		margin-top: 2.2em;
	}
	.prose h2 {
		font-size: 1.9rem;
	}
	.prose h3 {
		font-size: 1.5rem;
	}
	.prose a {
		color: var(--accent);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 3px;
	}
	.prose strong {
		font-weight: 500;
		color: var(--text);
	}
	.prose em {
		font-style: italic;
	}
	.prose blockquote {
		margin: 2.25em 0;
		padding: 0.25em 0 0.25em 1.5em;
		border-left: 2px solid var(--accent);
		font-family: var(--serif);
		font-style: italic;
		font-size: 1.35em;
		line-height: 1.5;
		color: var(--text);
	}
	.prose ul,
	.prose ol {
		padding-left: 1.4em;
	}
	.prose li + li {
		margin-top: 0.5em;
	}
	.prose li::marker {
		color: var(--accent);
	}
	.prose hr {
		border: 0;
		text-align: center;
		margin: 3em 0;
	}
	.prose hr::after {
		content: '· · ·';
		color: var(--accent);
		letter-spacing: 0.6em;
	}
	.prose img {
		margin: 2.5em auto;
		border: 1px solid var(--border);
	}
	.prose code {
		font-size: 0.9em;
		background: var(--surface);
		padding: 0.1em 0.35em;
	}

</style>
